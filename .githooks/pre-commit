#!/bin/sh
# Guardrail hook: block commits that introduce a stray H1 (# ) heading in any
# post body. The page title <h1> is generated by Chirpy from front matter, so a
# body-level # is always a duplicate / broken-outline bug.
# Installed via: git config core.hooksPath .githooks
set -e

PY=""
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
fi

if [ -z "$PY" ]; then
  echo "check-headings: python not found, skipping guard (CI will catch it)"
  exit 0
fi

"$PY" scripts/check-headings.py
